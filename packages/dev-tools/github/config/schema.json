{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://blockera.ai/schemas/blockera-ci.json",
	"title": "Blockera consumer CI config",
	"description": "Consumer overrides merged over packages/dev-tools/github/config/defaults.json. Only pluginSlug and repository are required in the consumer file; shared lint/test/workflow defaults come from defaults.json.",
	"type": "object",
	"required": ["pluginSlug", "repository"],
	"additionalProperties": false,
	"properties": {
		"pluginSlug": {
			"type": "string",
			"description": "WordPress product slug (plugin or theme directory name)."
		},
		"repository": {
			"type": "string",
			"description": "GitHub repository in owner/name form (used for workflow repo guards)."
		},
		"productType": {
			"type": "string",
			"enum": ["plugin", "theme"],
			"default": "plugin"
		},
		"submodule": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"path": {
					"type": "string",
					"default": "packages/global-packages"
				}
			}
		},
		"node": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"versionFile": {
					"type": "string",
					"default": ".nvmrc"
				}
			}
		},
		"php": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"defaultVersion": {
					"type": "string",
					"default": "7.4"
				}
			}
		},
		"lint": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"js": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"command": { "type": "string" }
					}
				},
				"css": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"command": { "type": "string" },
						"scssRoot": { "type": "string" },
						"scssGlob": { "type": "string" }
					}
				},
				"php": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"command": { "type": "string" },
						"reportPath": { "type": "string" }
					}
				}
			}
		},
		"test": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"jest": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"command": { "type": "string" },
						"build": {
							"type": "boolean",
							"default": true,
							"description": "Run buildCommand before Jest."
						},
						"buildCommand": {
							"type": "string",
							"default": "npm run build"
						},
						"composerInstall": {
							"type": "boolean",
							"default": false,
							"description": "Run Composer before build (needed when webpack resolves vendor paths)."
						},
						"composerCommand": { "type": "string" }
					}
				}
			}
		},
		"workflows": {
			"type": "object",
			"description": "Optional feature flags documenting which shared workflow templates this consumer enables.",
			"additionalProperties": {
				"type": "boolean"
			}
		}
	}
}
