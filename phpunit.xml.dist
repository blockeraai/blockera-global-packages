<!--
	PHPUnit config for this monorepo (blockeraai/blockera-global-packages).
	Runs shared-package tests that must not live in consumer suites
	(e.g. autoloader-coordinator). Consumer phpunit.xml.dist files stay product-local.
	@see https://github.com/wp-phpunit/docs
-->
<phpunit
        bootstrap="./packages/dev-phpunit/php/bootstrap.php"
        backupGlobals="false"
        colors="true"
        convertErrorsToExceptions="true"
        convertNoticesToExceptions="true"
        convertWarningsToExceptions="true"
        verbose="true"
        failOnEmptyTestSuite="false"
>
    <testsuites>
        <testsuite name="units">
            <directory suffix=".php">./packages/dev-phpunit/php/</directory>
            <directory suffix=".php">./packages/autoloader-coordinator/php/tests/</directory>
            <exclude>./node_modules/</exclude>
            <exclude>./vendor/</exclude>
        </testsuite>
    </testsuites>

    <php>
        <env name="VERSION" value="1.0-beta" />
        <const name="PHPUNIT_PLUGIN_TEST" value="true"/>
        <env name="__BLOCKERA_DIR__" value="blockera-global-packages" />
        <env name="WP_PHPUNIT__TESTS_CONFIG" value="./packages/dev-phpunit/php/config.php" />
        <env name="WP_TESTS_CONFIG_FILE_PATH" value="./packages/dev-phpunit/php/config.php" />
    </php>

</phpunit>
