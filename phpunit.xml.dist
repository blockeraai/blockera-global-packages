<!--
	PHPUnit config for this monorepo (blockeraai/blockera-global-packages).
	Runs shared-package tests that must not live in consumer suites
	(e.g. autoloader-coordinator). Products wp-env tests use phpunit.products.xml.dist.
	Consumer phpunit.xml.dist files stay product-local.

	Coordinator tests are Brain Monkey / plain PHPUnit (no wp-env). They stub the
	few WordPress APIs Coordinator calls from the global namespace.
-->
<phpunit
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
        bootstrap="./packages/autoloader-coordinator/php/tests/bootstrap.php"
        backupGlobals="false"
        colors="true"
        convertErrorsToExceptions="true"
        convertNoticesToExceptions="true"
        convertWarningsToExceptions="true"
        verbose="true"
        failOnEmptyTestSuite="false"
>
    <testsuites>
        <testsuite name="units">
            <directory suffix="Test.php">./packages/autoloader-coordinator/php/tests/</directory>
        </testsuite>
    </testsuites>

    <php>
        <const name="ABSPATH" value="/tmp/wordpress/"/>
        <const name="HOUR_IN_SECONDS" value="3600"/>
        <env name="VERSION" value="1.0-beta" />
        <const name="PHPUNIT_PLUGIN_TEST" value="true"/>
        <env name="__BLOCKERA_DIR__" value="blockera-global-packages" />
    </php>

</phpunit>
