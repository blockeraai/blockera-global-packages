{
	"name": "blockera/global-packages",
	"description": "Global packages for Blockera shared between all consumers (plugins, themes, etc.)",
	"type": "library",
	"license": "ISC",
	"authors": [
		{
			"name": "The Blockera Contributors"
		}
	],
	"minimum-stability": "dev",
	"repositories": [
		{
			"type": "path",
			"url": "packages/*",
			"options": {
				"symlink": true
			}
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"autoload-dev": {
		"psr-4": {
			"Blockera\\SharedAutoload\\Tests\\": "packages/autoloader-coordinator/php/tests/",
			"Blockera\\Products\\Tests\\": "packages/products/php/tests/"
		}
	},
	"require-dev": {
		"blockera/autoloader-coordinator": "*",
		"blockera/dev-phpunit": "*",
		"blockera/products": "*",
		"brain/monkey": "^2.6.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"mockery/mockery": "^1.6.12",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpunit/phpunit": "^9.5.21",
		"squizlabs/php_codesniffer": "^3.13.5",
		"vlucas/phpdotenv": "^5.5@dev",
		"wp-coding-standards/wpcs": "^3.4.1",
		"wp-phpunit/wp-phpunit": "dev-master",
		"yoast/phpunit-polyfills": "^2.0@dev"
	},
	"config": {
		"process-timeout": 0,
		"platform": {
			"php": "7.4"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "./bin/phpcs.sh --standard=phpcs.xml",
		"format": "phpcbf --standard=phpcs.xml --report-summary --report-source",
		"phpcs": "./bin/phpcs.sh",
		"phpcbf": "phpcbf",
		"test": "@php ./vendor/bin/phpunit"
	}
}
